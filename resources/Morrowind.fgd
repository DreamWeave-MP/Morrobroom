// Morrobroom Morrowind / TES3 authoring definitions.
//
// Morrowind.fgd owns TES3 game-record, reference, and cell semantics.
// Nif.fgd owns authored asset / scenegraph semantics. Brush-backed Morrowind
// entities explicitly compose NifGeometry when they own authored geometry.

@include "Nif.fgd"

// Common identity / placement data for authored Morrowind GameObjects.
// ESM3_RefId is optional: when omitted, Morrobroom generates a collision-safe ID.
// Supplying ESM3_RefId explicitly is intentional and may override an existing record.
@BaseClass = GameObject
[
    ESM3_RefId(string) : "TES3 record ID. Leave empty to generate a unique ID."
    ESM3_Name(string) : "Optional in-game display name."
    ESM3_Plugin(string) : "Source plugin for the indexed TES3 record."
    ESM3_ObjectFlags(string) : "TES3 record flags."
    mangle(string) : "TrenchBroom Y-up ZYX Euler rotation in degrees; Morrobroom converts it to TES3's Z-up reference rotation. Normally maintained by the editor/compiler."
]

@SolidClass base(GameObject, NifGeometry) = world_Detail : "Brush-authored GameObject"
[
]

@SolidClass base(NifGeometry) = worldspawn : "World entity"
[
	ESM3_FakeExterior(choices) : "Use sky for this cell" : 0 =
    [
        0 : "False"
        1 : "True"
    ]

	ESM3_HasWater(choices) : "Use water for this cell" : 0 =
    [
        0 : "False"
        1 : "True"
    ]

	ESM3_RestIsIllegal(choices) : "Whether resting in this cell is legal or not." : 0 =
    [
        0 : "False"
        1 : "True"
    ]

    ESM3_Region(string) : "Region to use for interior weather" : "Ascadian Isles Region"
    ESM3_Name(string) : "Override the cell name for this map. By default the name of the map is used for the interior." : "Balmora, Caius Cosades' House"
    ESM3_WaterHeight(float) : "Water Height for this cell. Ignored if not flagged to use water." : "0"
    ESM3_Ambient_color(color) : "Ambient lighting color" : "15 15 15"
    ESM3_FogDensity(float) : "Density of interior fog. Set between 0 and 1." : "0"
    ESM3_Fog_color(color) : "Color used for interior fog" : "15 15 15"
    ESM3_Sun_color(color) : "Color used for interior sunlight" : "15 15 15"
]

@baseclass size(-16 -16 -34, 16 16 33) color(0 255 0) = PlayerClass []

@PointClass base(PlayerClass) = info_player_start : "Player Scale Reference" []

// Begin common classes

@BaseClass base(GameObject) = baseObject
[
    ESM3_Model(string) : "Path the generated mesh is written to, relative to Meshes/. Optional. Defaults to <map name>/<ESM3_RefId>.nif."
]

@BaseClass base(baseObject) = Referenceable : "Base Entity"
[
    ESM3_Script(string) : "Id of the script used by the object. Optional. Be warned that all instances of this ESM3_RefId will share the script." : "fallingScript"
    ESM3_Icon(string) : "Ingame icon used by the object. Visible within TrenchBroom. Be sure to include the relative path to the icon." : "tx_goldicon.tga"
    ESM3_Value(integer) : "Gold value of the object ingame" : 420
    ESM3_Weight(float): "Weight of the object in Todd units." : "0.0"
]

@BaseClass base(Referenceable) = Wearable : "Wearable"
[
    ESM3_Enchantment(string): "Enchantment attached to the item. Requires a separate definition for the enchantment itself, which cannot be made in Trenchbroom." : "sc_icarianflight_en"
    ESM3_EnchantmentPoints(integer): "Strength of possible enchantments applied to this particular item." : 60
]

@BaseClass = WeaponData : "Weapon record data"
[
    ESM3_ChopMin(integer) : "Minimum chop damage"
    ESM3_ChopMax(integer) : "Maximum chop damage"
    ESM3_ThrustMin(integer) : "Minimum thrust damage"
    ESM3_ThrustMax(integer) : "Maximum thrust damage"
    ESM3_SlashMin(integer) : "Minimum slash damage"
    ESM3_SlashMax(integer) : "Maximum slash damage"
    ESM3_Health(integer) : "Weapon condition"
    ESM3_Reach(float) : "Weapon reach"
    ESM3_Speed(float) : "Weapon speed"
]

@BaseClass base(Referenceable) = DoorData : "Door record data"
[
    ESM3_SoundOpen(string) : "Sound played when the door opens"
    ESM3_SoundClose(string) : "Sound played when the door closes"
]

