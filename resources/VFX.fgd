// Morrobroom author-effect VFX catalog.
//
// Kurpulio / Kurp - VFX Meshbank - Modder's resource
// https://www.nexusmods.com/morrowind/mods/49695
//
// Editor previews only: Morrobroom does not compile these entities yet, and
// placing one prints a note and builds nothing. The static DAE models preserve
// source orientation and scale while discarding the giant meshbank showroom
// position.
//
// The catalog is intentionally explicit: one stable point-entity class per
// deduplicated source geometry.

@include "Nif.fgd"

@BaseClass base(NifGeometry, NifTransformable) = VFXAuthorEffect
[
]

// -----------------------------------------------------------------------------
// MESHBANK1
// -----------------------------------------------------------------------------

