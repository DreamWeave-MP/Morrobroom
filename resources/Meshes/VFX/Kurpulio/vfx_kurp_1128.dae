  <asset>
    <contributor><authoring_tool>Morrobroom Kurpulio VFX preview converter</authoring_tool></contributor>
    <unit name="unit" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_images>
    <image id="VFXTexture" name="darkmap_newgen-1.dds">
      <init_from>../../../Textures/Kurp/darkmap_newgen-1.dds</init_from>
    </image>
  </library_images>
  <library_effects>
    <effect id="PreviewEffect">
      <profile_COMMON>
        <newparam sid="VFXTexture-surface">
          <surface type="2D"><init_from>VFXTexture</init_from></surface>
        </newparam>
        <newparam sid="VFXTexture-sampler">
          <sampler2D><source>VFXTexture-surface</source></sampler2D>
        </newparam>
        <technique sid="common"><phong>
          <emission><color>0.08 0.08 0.08 1</color></emission>
          <ambient><color>0.2 0.2 0.2 1</color></ambient>
          <diffuse><texture texture="VFXTexture-sampler" texcoord="UVSET0"/></diffuse>
          <specular><color>0.15 0.15 0.15 1</color></specular>
          <shininess><float>8</float></shininess>
          <transparent opaque="A_ONE"><texture texture="VFXTexture-sampler" texcoord="UVSET0"/></transparent>
          <transparency><float>1</float></transparency>
        </phong></technique>
      </profile_COMMON>
      <extra><technique profile="GOOGLEEARTH"><double_sided>1</double_sided></technique></extra>
    </effect>
  </library_effects>
  <library_materials><material id="PreviewMaterial" name="PreviewMaterial"><instance_effect url="#PreviewEffect"/></material></library_materials>
